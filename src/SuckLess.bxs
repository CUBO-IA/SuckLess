/**
 * SuckLess Requirement Gate
 *
 * Agente de IA: LM Studio local (API compatible con OpenAI) escuchando en
 * http://localhost:1234/v1. No se necesita API key real de OpenAI.
 *
 * Ejecutar desde la raíz del repositorio:
 * boxlang --bx-config config/boxlang.json src/SuckLess.bxs
 */

// Endpoint de LM Studio expuesto en esta máquina
LM_STUDIO_BASE_URL = "http://localhost:1234/v1";
// LM Studio no valida credenciales, pero el proveedor exige un valor
LM_STUDIO_API_KEY  = "lm-studio";
// Los modelos locales con razonamiento pueden tardar varios minutos por llamada
AI_TIMEOUT_SECONDS = 600;

schemaPath = expandPath( "../schemas/requirement-evaluation.json" );
promptPath = expandPath( "../prompts/requirement-gate.md" );

evaluationTemplate = jsonDeserialize( fileRead( schemaPath ) );
systemPrompt = fileRead( promptPath );

// Detecta el modelo cargado en LM Studio (GET /v1/models)
lmStudioModel = "";
try {
    lmStudioResponse = http( url: LM_STUDIO_BASE_URL & "/models" )
        .method( "GET" )
        .timeout( 10 )
        .send();

    if ( val( listFirst( lmStudioResponse.statusCode, " " ) ) == 200 ) {
        lmStudioPayload = jsonDeserialize( lmStudioResponse.fileContent );
        if ( lmStudioPayload.data.len() > 0 ) {
            lmStudioModel = lmStudioPayload.data[ 1 ].id;
        }
    }
} catch ( any e ) {
    // LM Studio no está disponible; se reporta abajo
}

if ( !len( lmStudioModel ) ) {
    println( "No se pudo contactar con LM Studio en " & LM_STUDIO_BASE_URL & "/models" );
    println( "Abre LM Studio, carga un modelo y vuelve a ejecutar el script." );
    CLIExit( 1 );
}

println( "Agente IA: LM Studio (" & LM_STUDIO_BASE_URL & ")" );
println( "Modelo:    " & lmStudioModel );

function evaluateRequirement(
    required string requirement,
    array interviewHistory = []
) {
    userPrompt = "REQUERIMIENTO ACTUAL:" & char( 10 ) &
        requirement & char( 10 ) & char( 10 ) &
        "HISTORIAL DE PREGUNTAS Y RESPUESTAS:" & char( 10 ) &
        jsonSerialize( interviewHistory );

    return aiChat(
        messages: [
            {
                role: "system",
                content: systemPrompt
            },
            {
                role: "user",
                content: userPrompt
            }
        ],
        params: {
            temperature: 0.1,
            model: lmStudioModel
        },
        options: {
            provider: "openai-compatible",
            baseURL: LM_STUDIO_BASE_URL,
            apiKey: LM_STUDIO_API_KEY,
            timeout: AI_TIMEOUT_SECONDS,
            returnFormat: evaluationTemplate
        }
    );
}

function passesQualityGate( required struct evaluation ) {
    return evaluation.status == "READY_FOR_DEVELOPMENT" &&
        evaluation.score >= 80 &&
        evaluation.missingInformation.len() == 0 &&
        evaluation.contradictions.len() == 0 &&
        evaluation.acceptanceCriteria.len() >= 3;
}

function buildReport(
    required struct evaluation,
    required array interviewHistory
) {
    report = "## Requerimiento evaluado por SuckLess" & char( 10 ) & char( 10 );
    report &= "#### Estado" & char( 10 ) & char( 10 );
    report &= evaluation.status & char( 10 ) & char( 10 );
    report &= "#### Puntaje" & char( 10 ) & char( 10 );
    report &= evaluation.score & "/100" & char( 10 ) & char( 10 );
    report &= "#### Resumen" & char( 10 ) & char( 10 );
    report &= evaluation.summary & char( 10 ) & char( 10 );
    report &= "#### Requerimiento normalizado" & char( 10 ) & char( 10 );
    report &= evaluation.normalizedRequirement & char( 10 ) & char( 10 );
    report &= "#### Criterios de aceptación" & char( 10 );

    evaluation.acceptanceCriteria.each( criterion => {
        report &= char( 10 ) & "- " & criterion;
    } );

    report &= char( 10 ) & char( 10 ) & "#### Suposiciones" & char( 10 );

    if ( evaluation.assumptions.len() == 0 ) {
        report &= char( 10 ) & "- Ninguna";
    } else {
        evaluation.assumptions.each( assumption => {
            report &= char( 10 ) & "- " & assumption;
        } );
    }

    report &= char( 10 ) & char( 10 ) & "#### Historial de aclaraciones" & char( 10 );

    if ( interviewHistory.len() == 0 ) {
        report &= char( 10 ) & "- No se realizaron preguntas.";
    } else {
        interviewHistory.each( item => {
            report &= char( 10 ) & char( 10 ) & "###### Pregunta" & char( 10 ) & char( 10 );
            report &= item.question & char( 10 ) & char( 10 );
            report &= "**Respuesta:** " & item.answer;
        } );
    }

    return report & char( 10 );
}

println( "====================================" );
println( "       SuckLess Requirement Gate    " );
println( "====================================" );
println( "" );

requirement = CLIRead( "Escribe o pega el requerimiento inicial: " );

if ( requirement.trim().len() == 0 ) {
    println( "El requerimiento no puede estar vacío." );
    CLIExit( 1 );
}

interviewHistory = [];
finalEvaluation = {};
maxRounds = 8;

for ( round = 1; round <= maxRounds; round++ ) {
    println( "" );
    println( "Evaluando requerimiento..." );

    evaluation = evaluateRequirement( requirement, interviewHistory );

    println( "Estado: #evaluation.status#" );
    println( "Puntaje: #evaluation.score#/100" );
    println( "Resumen: #evaluation.summary#" );

    if ( passesQualityGate( evaluation ) ) {
        finalEvaluation = evaluation;
        break;
    }

    if ( evaluation.questions.len() == 0 ) {
        println( "El requerimiento necesita revisión humana y no hay más preguntas." );
        finalEvaluation = evaluation;
        break;
    }

    evaluation.questions.each( question => {
        println( "" );
        answer = CLIRead( question & char( 10 ) & "> " );

        interviewHistory.append( {
            question: question,
            answer: answer
        } );

        requirement &= char( 10 ) & char( 10 ) &
            "INFORMACIÓN CONFIRMADA:" & char( 10 ) &
            "Pregunta: " & question & char( 10 ) &
            "Respuesta: " & answer;
    } );

    finalEvaluation = evaluation;
}

outputPath = expandPath(
    "../output/requirement-" & dateTimeFormat( now(), "yyyyMMdd-HHmmss" ) & ".md"
);

fileWrite(
    outputPath,
    buildReport( finalEvaluation, interviewHistory ),
    "UTF-8",
    true
);

println( "" );
println( "Resultado guardado en:" );
println( outputPath );
