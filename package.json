{
  "name": "suckless",
  "version": "0.1.0",
  "description": "SuckLess — aclara requisitos, diagnostica errores, revisa código y comprueba con pruebas reales. ANIA × BoxLang AI Hackathon, Reto 10.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "cli": "node --disable-warning=ExperimentalWarning engine/cli.js",
    "panel": "node --disable-warning=ExperimentalWarning panel/server.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "store": "node demo-store/src/server.js",
    "uikit:build": "node scripts/build-uikit-harness.js"
  }
}
